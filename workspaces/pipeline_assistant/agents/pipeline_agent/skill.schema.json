{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill.schema.json",
  "title": "SkillAgent Profile Schema",
  "type": "object",
  "required": [
    "name",
    "description",
    "base_agent",
    "execution_defaults",
    "capabilities",
    "file_roles",
    "file_policies",
    "validation_policy",
    "output_contract",
    "refusal_behavior"
  ],

  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },

    "description": {
      "type": "string"
    },

    "base_agent": {
      "type": "string",
      "enum": ["SkillAgent"]
    },

    "execution_defaults": {
      "type": "object",
      "required": ["mode", "assumption_policy", "creativity_level"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["exploratory", "normal", "sdd"]
        },
        "verbosity": {
          "type": "string",
          "enum": ["freeform", "structured"],
          "default": "structured"
        },
        "assumption_policy": {
          "type": "string",
          "enum": ["allow", "warn", "forbid"]
        },
        "creativity_level": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },

    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "judge_alignment",
          "validate_against_spec",
          "detect_ambiguity",
          "propose_clarifications",
          "enforce_constraints",
          "block_progress"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },

    "disallowed_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },

    "file_roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["truth", "intent", "constraints", "subject"]
      }
    },

    "file_policies": {
      "type": "object",
      "required": ["truth", "intent", "constraints", "subject"],
      "properties": {
        "truth": {
          "$ref": "#/definitions/filePolicy"
        },
        "intent": {
          "$ref": "#/definitions/filePolicy"
        },
        "constraints": {
          "$ref": "#/definitions/filePolicy"
        },
        "subject": {
          "$ref": "#/definitions/filePolicy"
        }
      }
    },

    "validation_policy": {
      "type": "object",
      "required": [
        "require_spec",
        "require_constitution",
        "block_on_violation",
        "clarify_on_ambiguity",
        "allow_partial_compliance"
      ],
      "properties": {
        "require_spec": { "type": "boolean" },
        "require_constitution": { "type": "boolean" },
        "block_on_violation": { "type": "boolean" },
        "clarify_on_ambiguity": { "type": "boolean" },
        "allow_partial_compliance": { "type": "boolean" }
      }
    },

    "output_contract": {
      "type": "object",
      "required": ["format", "required_fields"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["structured", "freeform"]
        },
        "required_fields": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },

    "refusal_behavior": {
      "type": "object",
      "required": ["enabled", "style", "must_include"],
      "properties": {
        "enabled": { "type": "boolean" },
        "style": {
          "type": "string",
          "enum": ["explicit_and_actionable", "minimal"]
        },
        "must_include": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    }
  },

  "definitions": {
    "filePolicy": {
      "type": "object",
      "required": ["read", "write"],
      "properties": {
        "read": { "type": "boolean" },
        "write": {
          "type": "string",
          "enum": ["allowed", "restricted", "propose_only", "forbid"]
        }
      }
    }
  },

  "additionalProperties": false
}

