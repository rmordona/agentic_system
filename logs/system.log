ll set.\n'}, 'done': True, 'done_reason': 'stop', 'total_duration': 25573161700, 'load_duration': 1279175355, 'prompt_eval_count': 626, 'prompt_eval_duration': 4323228257, 'eval_count': 428, 'eval_duration': 19644544954}
