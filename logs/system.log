      "description": "Analyze broad market conditions (CPI, Rates, Fed) to determine if trading is safe.",
      "allowed_agents": [
        "MacroWatcher"
      ],
      "exit_condition": "macro_regime_is_defined(ctx)",
      "next_stages": [
        {
          "name": "ticker_discovery",
          "condition": "market_open_and_volatility_index(ctx)"
        },
        {
          "name": "block",
          "condition": "extreme_volatility_detected(ctx)"
        }
      ],
      "terminal": false
    },
    {
      "name": "ticker_discovery",
      "description": "Scan for specific ticker signals based on the User's watchlist or sector request.",
      "allowed_agents": [
        "QuantAnalyst",
        "SentimentScout"
      ],
      "exit_condition": "active_ticker_context_initialized(ctx)",
      "next_stages": [
        {
          "name": "deep_analysis",
          "condition": "ticker_signal_detected(ctx)"
        },
        {
          "name": "terminal",
          "condition": "no_trade_setup_found(ctx)"
        }
      ],
      "terminal": false
    },
    {
      "name": "deep_analysis",
      "description": "Parallel deep-dive. Quant checks technicals; Scout audits news and social sentiment.",
      "allowed_agents": [
        "QuantAnalyst",
        "SentimentScout"
      ],
      "exit_condition": "analysis_consensus_reached(ctx)",
      "next_stages": [
        {
          "name": "risk_audit",
          "condition": "is_bullish(ctx) || is_bearish(ctx)"
        },
        {
          "name": "block",
          "condition": "conflicting_data_detected(ctx) (e.g., Technicals Bullish, News Bearish)"
        }
      ],
      "terminal": false
    },
    {
      "name": "risk_audit",
      "description": "Red-team the trade idea. Audit for liquidity, earnings-call proximity, and portfolio VaR.",
      "allowed_agents": [
        "RiskGuard"
      ],
      "exit_condition": "risk_metrics_within_guardrails(ctx)",
      "next_stages": [
        {
          "name": "hitl_approval",
          "condition": "trade_size > SYSTEM_LIMIT"
        },
        {
          "name": "trade_execution",
          "condition": "risk_is_accepted(ctx)"
        },
        {
          "name": "block",
          "condition": "risk_threshold_exceeded(ctx)"
        }
      ],
      "terminal": false
    },
    {
      "name": "hitl_approval",
      "description": "Request manual human intervention for high-value or high-risk trades.",
      "allowed_agents": [
        "RiskGuard",
        "TraderAgent"
      ],
      "exit_condition": "hitl_action == \"APPROVED\" || hitl_action == \"REJECTED\"",
      "next_stages": [
        {
          "name": "trade_execution",
          "condition": "hitl_action == \"APPROVED\""
        },
        {
          "name": "terminal",
          "condition": "hitl_action == \"REJECTED\""
        }
      ],
      "terminal": false
    },
    {
      "name": "trade_execution",
      "description": "Atomic execution of the trade through the MCP-connected broker toolkit.",
      "allowed_agents": [
        "TraderAgent"
      ],
      "exit_condition": "order_status == \"FILLED\" || order_status == \"CANCELLED\"",
      "next_stages": [
        {
          "name": "post_trade_audit",
          "condition": null
        }
      ],
      "terminal": false
    },
    {
      "name": "post_trade_audit",
      "description": "Verify entry price, set stop-losses, and update the PLAN.md with exit strategy.",
      "allowed_agents": [
        "TraderAgent",
        "RiskGuard"
      ],
      "exit_condition": "state_ledger_updated(ctx)",
      "next_stages": [
        {
          "name": "terminal",
          "condition": null
        }
      ],
      "terminal": false
    },
    {
      "name": "block",
      "description": "Pipeline halted due to safety, data conflict, or risk violation. Requires manual reset.",
      "allowed_agents": [
        "MacroWatcher",
        "RiskGuard"
      ],
      "exit_condition": null,
      "next_stages": [
        {
          "name": "terminal",
          "condition": "incident_report_generated == True"
        }
      ],
      "terminal": false
    },
    {
      "name": "terminal",
      "description": "Task completed. Context cleared for next ticker cycle.",
      "allowed_agents": [],
      "exit_condition": null,
      "next_stages": [],
      "terminal": true
    }
  ]
}
